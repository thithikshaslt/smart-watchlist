# Copy this file to .env and fill in real values for local development.

DATABASE_URL=postgresql://watchlist:watchlist@localhost:5433/smart_watchlist?schema=public

JWT_SECRET=replace-with-a-long-random-secret

TWELVE_DATA_API_KEY=replace-with-your-twelve-data-api-key
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

PORT=3000

# Origin allowed to call this API from a browser (the frontend's dev server).
FRONTEND_ORIGIN=http://localhost:5173
